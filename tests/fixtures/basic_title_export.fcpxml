<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<!-- Title and effect extracted from the unchanged Final Cut Pro 12.3 canary export. -->
<fcpxml version="1.14">
    <resources>
        <format id="r1" name="FFVideoFormat720p30" frameDuration="100/3000s" width="1280" height="720" colorSpace="1-1-1 (Rec. 709)"/>
        <effect id="r2" name="Basic Title" uid=".../Titles.localized/Bumper:Opener.localized/Basic Title.localized/Basic Title.moti"/>
    </resources>
    <library>
        <event name="Title Export">
            <project name="Title Export">
                <sequence format="r1" duration="3s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
                    <spine>
                        <title ref="r2" offset="0s" name="Issue4 Canary Title" duration="3s" role="Titles.Titles-1">
                            <text>
                                <text-style ref="ts1">Title</text-style>
                            </text>
                            <text-style-def id="ts1">
                                <text-style font="Helvetica" fontSize="63" fontFace="Regular" fontColor="1 1 1 1" alignment="center"/>
                            </text-style-def>
                        </title>
                    </spine>
                </sequence>
            </project>
        </event>
    </library>
</fcpxml>
